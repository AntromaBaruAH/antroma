import tkinter as tk
from tkinter import messagebox
import pandas as pd
import os

# Global variables for entries
entries = {}
sample_data = {}

# Create the main application window for first GUI
root = tk.Tk()
root.title("Sample Collection")
root.geometry("500x400")
root.configure(bg="#f0f4f7")

# Function to save data to an Excel file and switch to the second GUI
def save_to_excel_and_switch():
    sample_id = entries['Sample ID'].get()

    if not sample_id:
        messagebox.showwarning("Input Error", "Sample ID cannot be empty!")
        return
    
    # Collect data from entry fields
    data = {key: entries[key].get() for key in entries if key != 'Sample ID'}
    sample_data['Sample ID'] = sample_id
    sample_data.update(data)
    
    # Create a DataFrame
    df = pd.DataFrame(data, index=[sample_id])
    
    file_name = 'sample_collection.xlsx'
    
    # Check if the file exists
    if not os.path.exists(file_name):
        df.to_excel(file_name, sheet_name='Samples')
    else:
        # Append data to the existing Excel file
        existing_df = pd.read_excel(file_name, index_col=0)
        combined_df = pd.concat([existing_df, df])
        combined_df.to_excel(file_name, sheet_name='Samples')
    
    messagebox.showinfo("Success", "Data saved successfully!")
    switch_to_second_gui()

